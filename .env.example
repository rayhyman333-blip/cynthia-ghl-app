# Cynthia for HighLevel — app environment.
# Copy to .env (or set in the shell / Render env) and fill in.
# Secrets live ONLY here — never in code, never in the repo history.

# --- HighLevel Developer Portal credentials -------------------------
# Portal: My Apps -> (the app) -> Advanced Settings -> Auth.
# Client Keys: generate a key pair; the secret is shown ONCE.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Shared Secret (same Auth page) — decrypts Custom Page user context.
GHL_SHARED_SECRET=
# Must EXACTLY match a redirect URL registered in the portal.
GHL_REDIRECT_URI=https://<APP_HOST>/oauth/callback
# Minimum scopes the app needs. v1 needs none (see config.py).
GHL_SCOPES=
# Location (sub-account installs; recommended) or Company.
GHL_USER_TYPE=Location
# 1 = build install links on the white-label domain
# (marketplace.leadconnectorhq.com) instead of marketplace.gohighlevel.com.
GHL_WHITELABEL_INSTALL=

# --- Cynthia bridge ---------------------------------------------------
# The live Cynthia MCP server (demo mode + default route).
CYNTHIA_MCP_URL=https://cynthia-mcp-server.onrender.com/mcp
# Optional: base URL of a deployed Cynthia REST facade
# (POST /ask, GET /status). The facade exists in code but is not
# deployed yet; leave empty until one is.
CYNTHIA_REST_URL=

# --- Server / storage -------------------------------------------------
HOST=0.0.0.0
PORT=8200
STORE_PATH=data/store.json

# --- Webhooks ---------------------------------------------------------
# HighLevel's published Ed25519 webhook public key (SPKI, base64).
# This is a PUBLIC value; the default in config.py is already correct.
# GHL_WEBHOOK_PUBLIC_KEY_B64=MCowBQYDK2VwAyEAi2HR1srL4o18O8BRa7gVJY7G7bupbN3H9AwJrHCDiOg=
# LOCAL DEV ONLY — accept unsigned webhooks (hand-sent test payloads).
# NEVER set this in production.
WEBHOOK_ALLOW_UNSIGNED_LOCAL=
